.enemy-root {
    flex-grow: 1;
    padding: 12px;
    background-color: rgb(24, 27, 33);
    color: rgb(222, 227, 234);
}

.enemy-header {
    height: 58px;
    min-height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(31, 36, 44);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}
.enemy-title { font-size: 18px; -unity-font-style: bold; color: rgb(241, 245, 250); }
.enemy-subtitle { margin-top: 3px; font-size: 11px; color: rgb(151, 161, 176); }
.enemy-count {
    padding: 5px 10px;
    background-color: rgb(44, 52, 64);
    color: rgb(167, 210, 255);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-font-style: bold;
}

.enemy-toolbar {
    height: 40px;
    min-height: 40px;
    flex-shrink: 0;
    margin-top: 8px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(31, 35, 42);
}
.enemy-toolbar > * { margin-right: 6px; }
.enemy-toolbar .unity-base-field { width: 205px; }
.enemy-toolbar .unity-base-field__label { min-width: 34px; width: 34px; color: rgb(170, 179, 191); }
.enemy-button {
    height: 25px;
    color: rgb(211, 218, 228);
    background-color: rgb(50, 57, 68);
    border-left-color: rgb(71, 81, 96);
    border-right-color: rgb(71, 81, 96);
    border-top-color: rgb(71, 81, 96);
    border-bottom-color: rgb(71, 81, 96);
}
.enemy-button:hover { background-color: rgb(62, 72, 87); }
.enemy-button--primary { background-color: rgb(31, 104, 162); color: white; -unity-font-style: bold; }

.enemy-formula {
    min-height: 27px;
    flex-shrink: 0;
    margin-top: 5px;
    padding: 5px 10px;
    background-color: rgb(27, 45, 58);
    color: rgb(160, 207, 235);
    font-size: 11px;
}

.enemy-table-frame {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    margin-top: 6px;
    background-color: rgb(20, 23, 28);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(51, 58, 69);
    border-right-color: rgb(51, 58, 69);
    border-top-color: rgb(51, 58, 69);
    border-bottom-color: rgb(51, 58, 69);
}
.enemy-table-scroll { flex-grow: 1; min-height: 0; }
.enemy-table-content { min-width: 1066px; flex-shrink: 0; }
.enemy-table-header, .enemy-row { flex-direction: row; flex-shrink: 0; }
.enemy-table-header { height: 34px; min-height: 34px; background-color: rgb(43, 49, 59); }
.enemy-row {
    height: 44px;
    min-height: 44px;
    background-color: rgb(28, 32, 39);
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 51, 61);
}
.enemy-row:hover { background-color: rgb(34, 40, 49); }
.enemy-row--dirty { background-color: rgb(45, 43, 30); }
.enemy-cell {
    flex-shrink: 0;
    justify-content: center;
    padding-left: 4px;
    padding-right: 4px;
    border-right-width: 1px;
    border-right-color: rgb(47, 54, 64);
}
.enemy-cell > .unity-label { font-size: 10px; -unity-text-align: middle-center; white-space: normal; }
.enemy-header-cell { background-color: rgb(43, 49, 59); }
.enemy-header-label { color: rgb(194, 202, 214); -unity-font-style: bold; }
.enemy-portrait { width: 40px; height: 40px; align-self: center; }
.enemy-number-field .unity-base-field__input {
    min-height: 24px;
    padding-left: 3px;
    padding-right: 3px;
    background-color: rgb(19, 22, 27);
    color: rgb(232, 237, 244);
    -unity-text-align: middle-right;
}
.enemy-derived { background-color: rgba(33, 91, 126, 0.16); }
.enemy-value { color: rgb(143, 211, 255); -unity-font-style: bold; }

.ew-profile { width: 58px; }
.ew-name { width: 130px; }
.ew-role { width: 76px; }
.ew-multiplier { width: 80px; }
.ew-stat { width: 80px; }
.ew-derived { width: 88px; }
.ew-open { width: 58px; }

.enemy-footer {
    height: 29px;
    min-height: 29px;
    flex-shrink: 0;
    margin-top: 5px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(31, 35, 42);
}
.enemy-dirty { width: 110px; color: rgb(139, 150, 164); -unity-font-style: bold; }
.enemy-dirty--active { color: rgb(255, 200, 90); }
.enemy-status { flex-grow: 1; color: rgb(137, 180, 213); }
.enemy-status--warning { color: rgb(255, 174, 91); }
