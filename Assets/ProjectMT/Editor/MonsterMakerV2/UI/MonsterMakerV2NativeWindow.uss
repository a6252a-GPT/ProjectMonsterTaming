.maker-root {
    flex-grow: 1;
    min-width: 1418px;
    min-height: 760px;
    padding: 8px;
    background-color: rgb(25, 28, 34);
    color: rgb(224, 228, 235);
}
.maker-root.maker-root--catalog-collapsed { min-width: 1180px; }

.maker-workspace { flex-grow: 1; min-height: 0; flex-direction: row; }
.panel {
    min-height: 0;
    padding: 10px;
    background-color: rgb(31, 35, 42);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(57, 64, 75);
    border-right-color: rgb(57, 64, 75);
    border-top-color: rgb(57, 64, 75);
    border-bottom-color: rgb(57, 64, 75);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}
.catalog-panel { width: 230px; min-width: 230px; max-width: 230px; margin-right: 8px; }
.editor-panel { width: 430px; min-width: 430px; max-width: 430px; margin-right: 8px; }
.preview-panel { flex-grow: 1; min-width: 420px; }

.panel-header {
    min-height: 44px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 6px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 55, 66);
}
.panel-title-area { flex-grow: 1; min-width: 0; }
.panel-title, .column-heading, .card-title, .section-title {
    -unity-font-style: bold;
    color: rgb(236, 239, 244);
}
.panel-title { font-size: 15px; }
.panel-caption, .column-meta, .card-meta, .toolbar-hint {
    color: rgb(151, 160, 174);
    font-size: 10px;
    white-space: normal;
}
.panel-caption { margin-top: 3px; }
.count-badge, .state-badge {
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    font-size: 10px;
}
.count-badge { margin-left: 5px; background-color: rgb(54, 62, 75); color: rgb(192, 200, 212); }

.catalog-search-row {
    height: 27px;
    min-height: 27px;
    flex-shrink: 0;
    margin-bottom: 5px;
    flex-direction: row;
    align-items: center;
}
.catalog-search-label {
    width: 34px;
    min-width: 34px;
    color: rgb(174, 184, 199);
    font-size: 10px;
}
.catalog-search {
    flex-grow: 1;
    min-width: 0;
    height: 22px;
    min-height: 22px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
}
.catalog-search > .unity-base-text-field__input {
    height: 22px;
    min-height: 22px;
    padding-left: 6px;
    background-color: rgb(27, 31, 38);
    color: rgb(222, 228, 237);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(60, 69, 82);
    border-right-color: rgb(60, 69, 82);
    border-top-color: rgb(60, 69, 82);
    border-bottom-color: rgb(60, 69, 82);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}
.catalog-search > .unity-base-text-field__input:focus {
    border-left-color: rgb(83, 148, 211);
    border-right-color: rgb(83, 148, 211);
    border-top-color: rgb(83, 148, 211);
    border-bottom-color: rgb(83, 148, 211);
}
.segmented-control {
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    margin-bottom: 5px;
}
.segmented-button {
    flex-grow: 1;
    height: 24px;
    margin-left: 0;
    margin-right: 0;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: rgb(45, 50, 59);
    border-left-color: rgb(64, 71, 83);
    border-right-color: rgb(64, 71, 83);
    border-top-color: rgb(64, 71, 83);
    border-bottom-color: rgb(64, 71, 83);
    color: rgb(166, 174, 187);
}
.segmented-button--active {
    background-color: rgb(47, 92, 139);
    border-left-color: rgb(82, 148, 218);
    border-right-color: rgb(82, 148, 218);
    border-top-color: rgb(82, 148, 218);
    border-bottom-color: rgb(82, 148, 218);
    color: rgb(232, 242, 253);
    -unity-font-style: bold;
}
.catalog-list-frame, .catalog-list { flex-grow: 1; min-height: 0; }
.catalog-list-frame { overflow: hidden; }
.catalog-list {
    overflow: hidden;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.catalog-row {
    flex-grow: 1;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    height: 52px;
    margin-top: 1px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 5px;
    flex-direction: row;
    align-items: center;
    border-left-width: 3px;
    background-color: rgb(42, 46, 54);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}
.catalog-row:hover { background-color: rgb(50, 56, 66); }
.catalog-row.unity-collection-view__item--selected,
.unity-collection-view__item--selected .catalog-row {
    background-color: rgb(35, 78, 122);
    border-left-width: 4px;
}
.catalog-row__portrait {
    width: 36px;
    min-width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-right: 7px;
    background-color: rgb(26, 29, 35);
}
.catalog-row__text { flex-grow: 1; min-width: 0; overflow: hidden; }
.catalog-row__name {
    height: 16px;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
    -unity-font-style: bold;
    color: rgb(235, 238, 243);
    font-size: 11px;
}
.catalog-row__meta, .catalog-row__state { height: 13px; font-size: 9px; }
.catalog-row__meta, .catalog-row__state {
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}
.catalog-row__meta { color: rgb(151, 160, 174); }
.catalog-row__state { color: rgb(139, 194, 240); }
.catalog-row--legacy { opacity: 0.72; }
.catalog-row--legacy .catalog-row__state { color: rgb(133, 142, 156); }
.rarity-common { border-left-color: rgb(125, 130, 137); }
.rarity-rare { border-left-color: rgb(76, 139, 210); }
.rarity-epic { border-left-color: rgb(151, 91, 205); }
.rarity-legendary { border-left-color: rgb(220, 181, 70); }
.rarity-mythic { border-left-color: rgb(214, 82, 82); }
.empty-message {
    display: none;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    color: rgb(133, 142, 156);
    -unity-text-align: middle-center;
    white-space: normal;
}
.catalog-status {
    min-height: 28px;
    margin-top: 5px;
    padding: 5px;
    color: rgb(149, 170, 194);
    background-color: rgb(35, 40, 48);
    border-left-width: 2px;
    border-left-color: rgb(64, 91, 119);
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    font-size: 9px;
    white-space: normal;
}

.catalog-actions, .draft-header-actions, .view-toolbar, .preview-control-toolbar,
.playback-toolbar, .publish-toolbar, .card-heading-row, .timeline-heading {
    flex-direction: row;
}
.catalog-actions {
    height: 28px;
    min-height: 28px;
    flex-shrink: 0;
    margin-top: 5px;
}
.draft-header {
    height: 100px;
    min-height: 100px;
    flex-shrink: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 6px;
    margin-bottom: 6px;
    background-color: rgb(27, 31, 37);
    border-bottom-width: 2px;
    border-bottom-color: rgb(97, 168, 255);
}
.draft-title-row { height: 28px; flex-direction: row; align-items: center; }
.maker-title { flex-grow: 1; font-size: 18px; -unity-font-style: bold; color: rgb(244, 247, 251); }
.catalog-toggle-button {
    width: 62px;
    height: 21px;
    margin-right: 6px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(43, 49, 59);
    border-left-color: rgb(70, 79, 93);
    border-right-color: rgb(70, 79, 93);
    border-top-color: rgb(70, 79, 93);
    border-bottom-color: rgb(70, 79, 93);
    color: rgb(174, 184, 199);
    font-size: 9px;
}
.catalog-toggle-button:hover { background-color: rgb(55, 64, 76); color: rgb(221, 226, 234); }
.help-toggle-button {
    width: 68px;
    height: 21px;
    margin-right: 6px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(43, 49, 59);
    border-left-color: rgb(70, 79, 93);
    border-right-color: rgb(70, 79, 93);
    border-top-color: rgb(70, 79, 93);
    border-bottom-color: rgb(70, 79, 93);
    color: rgb(174, 184, 199);
    font-size: 9px;
}
.help-toggle-button:hover { background-color: rgb(55, 64, 76); color: rgb(221, 226, 234); }
.help-toggle-button--hidden {
    background-color: rgb(43, 66, 87);
    border-left-color: rgb(70, 117, 157);
    border-right-color: rgb(70, 117, 157);
    border-top-color: rgb(70, 117, 157);
    border-bottom-color: rgb(70, 117, 157);
    color: rgb(180, 216, 243);
}
.state-badge--saved { background-color: rgb(39, 86, 68); color: rgb(159, 224, 190); }
.state-badge--dirty { background-color: rgb(111, 77, 37); color: rgb(255, 210, 139); }
.draft-status { height: 28px; color: rgb(153, 164, 181); font-size: 10px; white-space: normal; }
.draft-header-actions { height: 28px; }
.editor-column-header { height: 38px; padding: 6px 7px; background-color: rgb(35, 40, 48); }
.column-heading { font-size: 13px; }
.column-meta { margin-top: 2px; }
.draft-scroll { flex-grow: 1; min-height: 0; margin-top: 4px; }
.draft-section {
    margin-bottom: 7px;
    padding: 8px;
    background-color: rgb(36, 40, 48);
    border-left-width: 2px;
    border-left-color: rgb(74, 91, 111);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.section-title {
    height: 25px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 59, 70);
    font-size: 12px;
}
.section-content { padding-top: 3px; padding-left: 2px; padding-right: 2px; }
.draft-property { margin-top: 1px; margin-bottom: 2px; }
.draft-property > .unity-base-field__label {
    min-width: 142px;
    width: 142px;
    max-width: 142px;
    flex-basis: 142px;
    flex-grow: 0;
    flex-shrink: 0;
    color: rgb(174, 184, 199);
}
.draft-property > .unity-base-field__input { min-width: 0; flex-grow: 1; }
.draft-property--stacked > .unity-base-field__label {
    min-width: 0;
    width: 100%;
    max-width: 100%;
    flex-basis: auto;
    flex-grow: 1;
    flex-shrink: 1;
}
.draft-subfoldout {
    margin-top: 5px;
    padding: 5px;
    background-color: rgb(31, 35, 42);
    border-left-width: 1px;
    border-left-color: rgb(77, 89, 106);
}
.draft-subfoldout > .unity-foldout__toggle { min-height: 24px; -unity-font-style: bold; }
.draft-help { margin-top: 4px; margin-bottom: 4px; }
.maker-root--context-help-hidden .draft-help--optional,
.maker-root--context-help-hidden .context-help { display: none; }
.draft-action-row { flex-direction: row; margin-top: 4px; margin-bottom: 3px; }
.draft-action-row > Button { min-width: 0; flex-basis: 0; flex-grow: 1; }
.skill-tab-row {
    height: 32px;
    min-height: 32px;
    flex-shrink: 0;
    flex-direction: row;
    margin-top: 2px;
    margin-bottom: 7px;
    padding: 2px;
    background-color: rgb(27, 31, 37);
    border-bottom-width: 1px;
    border-bottom-color: rgb(55, 64, 76);
}
.skill-tab-button {
    height: 27px;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    margin-left: 1px;
    margin-right: 1px;
    background-color: rgb(39, 45, 54);
    color: rgb(155, 166, 181);
    border-left-color: rgb(55, 64, 76);
    border-right-color: rgb(55, 64, 76);
    border-top-color: rgb(55, 64, 76);
    border-bottom-color: rgb(55, 64, 76);
}
.skill-tab-button:hover {
    background-color: rgb(48, 58, 70);
    color: rgb(214, 223, 235);
}
.skill-tab-button--active {
    background-color: rgb(46, 82, 112);
    color: rgb(226, 240, 250);
    border-bottom-width: 2px;
    border-bottom-color: rgb(91, 174, 227);
    -unity-font-style: bold;
}
.summary-card {
    margin-top: 5px;
    margin-bottom: 5px;
    padding: 7px;
    background-color: rgb(29, 44, 56);
    border-left-width: 3px;
    border-left-color: rgb(78, 144, 202);
}
.summary-title { -unity-font-style: bold; color: rgb(213, 230, 245); }
.summary-body { margin-top: 3px; color: rgb(165, 182, 199); font-size: 10px; white-space: normal; }

.secondary-button, .primary-button, .link-button, .motion-button,
.validate-button, .publish-button, .draft-action-button, .validation-item {
    height: 27px;
    margin-left: 2px;
    margin-right: 2px;
    border-left-color: rgb(76, 86, 101);
    border-right-color: rgb(76, 86, 101);
    border-top-color: rgb(76, 86, 101);
    border-bottom-color: rgb(76, 86, 101);
    color: rgb(225, 230, 237);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}
.secondary-button { flex-grow: 1; background-color: rgb(54, 62, 74); font-size: 9px; }
.secondary-button:hover { background-color: rgb(66, 77, 92); }
.primary-button { flex-grow: 1; background-color: rgb(44, 104, 156); }
.primary-button:hover, .publish-button:hover { background-color: rgb(55, 121, 178); }
.draft-action-button, .link-button { background-color: rgb(49, 78, 104); color: rgb(178, 217, 248); }
.danger-button { background-color: rgb(92, 50, 54); color: rgb(246, 189, 189); }
.discard-button {
    background-color: rgb(65, 48, 53);
    border-left-color: rgb(105, 68, 75);
    border-right-color: rgb(105, 68, 75);
    border-top-color: rgb(105, 68, 75);
    border-bottom-color: rgb(105, 68, 75);
    color: rgb(232, 194, 199);
}
.discard-button:hover { background-color: rgb(82, 54, 60); }
.secondary-button:disabled, .primary-button:disabled, .motion-button:disabled,
.validate-button:disabled, .publish-button:disabled, .draft-action-button:disabled {
    opacity: 0.45;
}
.catalog-actions > Button, .draft-header-actions > Button,
.preview-control-toolbar > Button, .playback-toolbar > Button {
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
}

.preview-header { align-items: center; }
.preview-analysis-tools {
    height: 28px;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-left: 8px;
    margin-right: 7px;
    padding: 2px;
    background-color: rgb(27, 31, 37);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.preview-tool-button {
    width: 90px;
    height: 24px;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgb(43, 61, 75);
    color: rgb(178, 216, 240);
    border-left-color: rgb(65, 88, 105);
    border-right-color: rgb(65, 88, 105);
    border-top-color: rgb(65, 88, 105);
    border-bottom-color: rgb(65, 88, 105);
    font-size: 9px;
}
.preview-tool-button:hover { background-color: rgb(52, 77, 96); color: rgb(223, 239, 250); }
.environment-field { width: 160px; flex-shrink: 0; }
.environment-field > .unity-base-field__label { min-width: 36px; width: 36px; }
.view-toolbar {
    height: 32px;
    margin-bottom: 6px;
    padding-left: 5px;
    padding-right: 5px;
    align-items: center;
    background-color: rgb(27, 31, 37);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.toolbar-label { width: 58px; color: rgb(174, 184, 199); font-size: 10px; }
.view-toolbar > .secondary-button { flex-grow: 0; width: 58px; }
.toolbar-hint { flex-grow: 1; -unity-text-align: middle-right; padding-right: 4px; }
.preview-render-host {
    position: relative;
    flex-grow: 1;
    min-height: 230px;
    background-color: rgb(14, 17, 21);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(54, 61, 72);
    border-right-color: rgb(54, 61, 72);
    border-top-color: rgb(54, 61, 72);
    border-bottom-color: rgb(54, 61, 72);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.preview-imgui {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.bottom-workspace {
    height: 388px;
    min-height: 358px;
    flex-shrink: 0;
    flex-direction: row;
    margin-top: 8px;
}
.bottom-workspace--validation {
    height: 458px;
    min-height: 438px;
}
.work-card {
    padding: 8px;
    background-color: rgb(35, 40, 48);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(57, 66, 79);
    border-right-color: rgb(57, 66, 79);
    border-top-color: rgb(57, 66, 79);
    border-bottom-color: rgb(57, 66, 79);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.card-heading-row {
    height: 24px;
    min-height: 24px;
    flex-shrink: 0;
    padding-bottom: 3px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(52, 61, 73);
}
.card-title { font-size: 11px; }
.card-meta { flex-grow: 1; margin-left: 7px; }
.profile-card { width: 260px; min-width: 230px; margin-right: 7px; }
.profile-identity {
    height: 78px;
    min-height: 78px;
    flex-shrink: 0;
    flex-direction: row;
    margin-top: 3px;
}
.profile-portrait {
    width: 72px;
    height: 72px;
    margin-right: 8px;
    background-color: rgb(24, 27, 33);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(53, 62, 74);
    border-right-color: rgb(53, 62, 74);
    border-top-color: rgb(53, 62, 74);
    border-bottom-color: rgb(53, 62, 74);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.profile-identity-text { flex-grow: 1; min-width: 0; }
.profile-name { height: 23px; font-size: 15px; -unity-font-style: bold; color: rgb(238, 241, 246); }
.profile-rarity {
    height: 20px;
    margin-bottom: 3px;
    padding-left: 6px;
    -unity-text-align: middle-left;
    color: white;
    -unity-font-style: bold;
}
.rarity-common-bg { background-color: rgb(84, 81, 77); }
.rarity-rare-bg { background-color: rgb(49, 94, 162); }
.rarity-epic-bg { background-color: rgb(132, 69, 176); }
.rarity-legendary-bg { background-color: rgb(202, 176, 70); }
.rarity-mythic-bg { background-color: rgb(155, 31, 27); }
.profile-section-title {
    height: 19px;
    min-height: 19px;
    flex-shrink: 0;
    margin-top: 3px;
    padding-top: 3px;
    border-top-width: 1px;
    border-top-color: rgb(52, 61, 73);
    color: rgb(155, 169, 188);
    -unity-font-style: bold;
    font-size: 10px;
}
.profile-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
    padding: 4px 6px;
    background-color: rgb(30, 34, 41);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}
.profile-grid > .profile-value { width: 49%; }
.profile-value {
    height: 17px;
    min-height: 17px;
    flex-shrink: 0;
    color: rgb(205, 214, 226);
    font-size: 10px;
}
.profile-line { white-space: nowrap; -unity-text-overflow-position: end; overflow: hidden; }
.command-stack { flex-grow: 1; min-width: 0; min-height: 0; }
.timeline-card, .edit-card, .motion-card { margin-bottom: 8px; }
.timeline-heading { height: 22px; align-items: center; }
.timeline-heading > .card-meta { flex-grow: 1; }
.timeline-value {
    width: 52px;
    padding-right: 5px;
    -unity-text-align: middle-right;
    color: rgb(188, 204, 223);
    background-color: rgb(29, 34, 42);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    font-size: 10px;
}
.timeline-slider { flex-grow: 1; }
.timeline-hint { -unity-text-align: middle-center; color: rgb(126, 137, 152); font-size: 9px; }
.preview-control-toolbar {
    height: 62px;
    min-height: 62px;
    flex-direction: column;
    padding: 3px 4px;
    background-color: rgb(30, 35, 43);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(49, 59, 72);
    border-right-color: rgb(49, 59, 72);
    border-top-color: rgb(49, 59, 72);
    border-bottom-color: rgb(49, 59, 72);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}
.control-row {
    height: 28px;
    min-height: 28px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}
.control-row--history { margin-top: 1px; }
.control-row-label {
    width: 52px;
    min-width: 52px;
    flex-shrink: 0;
    padding-left: 5px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    color: rgb(139, 154, 172);
    font-size: 9px;
}
.control-group {
    height: 27px;
    min-width: 0;
    flex-grow: 1;
    flex-direction: row;
}
.control-group > Button {
    height: 26px;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    margin-left: 2px;
    margin-right: 2px;
}
.control-group > .area-button {
    background-color: rgb(38, 57, 75);
    border-left-color: rgb(67, 104, 137);
    border-right-color: rgb(67, 104, 137);
    border-top-color: rgb(67, 104, 137);
    border-bottom-color: rgb(67, 104, 137);
    color: rgb(187, 216, 239);
}
.control-group > .area-button:hover { background-color: rgb(46, 71, 94); }
.playback-toolbar { height: 34px; min-height: 34px; align-items: center; }
.motion-row-label {
    width: 52px;
    min-width: 52px;
    height: 30px;
    margin-right: 2px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(141, 157, 177);
    background-color: rgb(29, 34, 42);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    font-size: 9px;
}
.motion-button { flex-basis: 0; flex-grow: 1; min-width: 0; height: 32px; margin-left: 2px; margin-right: 2px; background-color: rgb(55, 64, 77); }
.motion-button:hover { background-color: rgb(66, 78, 94); }
.motion-button--idle { background-color: rgb(51, 62, 75); }
.motion-button--move { background-color: rgb(47, 70, 91); color: rgb(191, 218, 239); }
.motion-button--danger { background-color: rgb(91, 59, 62); }
.motion-button--danger:hover { background-color: rgb(112, 66, 70); }
.motion-button--active { background-color: rgb(106, 84, 35); color: rgb(255, 226, 152); }
.motion-button--active:hover { background-color: rgb(129, 101, 40); }
.combat-playback-row { height: 34px; min-height: 34px; flex-direction: row; align-items: center; min-width: 0; }
.attack-buttons-host { flex-basis: 0; flex-grow: 1; min-width: 0; height: 34px; flex-direction: row; }
.attack-buttons { width: 100%; min-width: 100%; flex-grow: 1; flex-direction: row; }
.attack-buttons > .motion-button {
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    padding-left: 3px;
    padding-right: 3px;
    font-size: 9px;
    overflow: hidden;
    background-color: rgb(49, 78, 108);
}
.attack-buttons > .motion-button--random { background-color: rgb(60, 66, 77); color: rgb(188, 196, 207); }
.attack-empty { padding: 8px; color: rgb(132, 143, 158); }
.active-motion-slot {
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    height: 34px;
    flex-direction: row;
}
.active-motion-slot > .active-motion-button {
    width: auto;
    min-width: 0;
    flex-grow: 1;
}
.combat-status-card {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    min-height: 48px;
    padding: 7px;
    background-color: rgba(25, 31, 39, 0.9);
    border-left-width: 2px;
    border-left-color: rgb(97, 168, 255);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(56, 68, 82);
    border-top-color: rgb(56, 68, 82);
    border-bottom-color: rgb(56, 68, 82);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.combat-status { -unity-font-style: bold; color: rgb(210, 220, 233); }
.combat-detail { margin-top: 3px; color: rgb(147, 158, 174); font-size: 10px; }
.command-details-scroll {
    flex-grow: 1;
    min-height: 34px;
    margin-top: 0;
}
.command-details-scroll > .unity-scroll-view__content-container { padding-right: 2px; }
.validation-card {
    display: none;
    min-height: 104px;
    margin-bottom: 6px;
    padding: 7px;
    background-color: rgb(36, 41, 49);
    border-left-width: 2px;
    border-left-color: rgb(72, 91, 113);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(53, 62, 74);
    border-top-color: rgb(53, 62, 74);
    border-bottom-color: rgb(53, 62, 74);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.validation-summary { height: 20px; -unity-font-style: bold; color: rgb(195, 204, 216); }
.validation-list { flex-grow: 1; min-height: 50px; max-height: 120px; }
.validation-item {
    min-height: 25px;
    height: auto;
    margin-bottom: 3px;
    white-space: normal;
    -unity-text-align: middle-left;
    background-color: rgb(58, 52, 41);
    color: rgb(230, 181, 117);
}
.validation-item--error { background-color: rgb(73, 43, 45); color: rgb(240, 139, 139); }
.validation-item--warning { background-color: rgb(70, 58, 40); color: rgb(239, 192, 110); }
.validation-item--success { color: rgb(133, 214, 164); }
.publish-toolbar {
    height: 44px;
    margin-bottom: 8px;
    padding: 4px;
    flex-shrink: 0;
    align-items: center;
    background-color: rgb(30, 35, 43);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(50, 60, 73);
    border-right-color: rgb(50, 60, 73);
    border-top-color: rgb(50, 60, 73);
    border-bottom-color: rgb(50, 60, 73);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.validate-button {
    width: auto;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    height: 34px;
    margin-right: 3px;
    background-color: rgb(55, 51, 41);
    border-left-width: 3px;
    border-left-color: rgb(170, 138, 68);
    border-right-color: rgb(91, 78, 51);
    border-top-color: rgb(91, 78, 51);
    border-bottom-color: rgb(91, 78, 51);
    color: rgb(238, 210, 146);
}
.validate-button:hover { background-color: rgb(69, 62, 46); }
.publish-button {
    width: auto;
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    height: 34px;
    margin-left: 3px;
    background-color: rgb(39, 65, 91);
    border-left-width: 3px;
    border-left-color: rgb(76, 143, 203);
    border-right-color: rgb(61, 91, 120);
    border-top-color: rgb(61, 91, 120);
    border-bottom-color: rgb(61, 91, 120);
    color: rgb(205, 229, 252);
    -unity-font-style: bold;
}
.usage-guide {
    margin-bottom: 0;
    padding: 1px 7px;
    background-color: rgb(35, 40, 48);
    border-left-width: 2px;
    border-left-color: rgb(93, 112, 139);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(53, 62, 74);
    border-top-color: rgb(53, 62, 74);
    border-bottom-color: rgb(53, 62, 74);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}
.usage-guide > .unity-foldout__toggle { min-height: 24px; -unity-font-style: bold; }
.guide-step { margin: 3px 5px; color: rgb(188, 198, 212); font-size: 10px; white-space: normal; }
