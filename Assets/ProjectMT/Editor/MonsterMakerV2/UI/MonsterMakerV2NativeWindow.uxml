<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/ProjectMT/Editor/MonsterMakerV2/UI/MonsterMakerV2NativeWindow.uss?fileID=7433441132597879392&amp;guid=c1f8bd38c88fa21469543fac9890fa05&amp;type=3#MonsterMakerV2NativeWindow" />
    <ui:VisualElement class="maker-root">
        <ui:VisualElement class="maker-workspace">
            <ui:VisualElement name="catalog-panel" class="catalog-panel panel">
                <ui:VisualElement class="panel-header">
                    <ui:VisualElement class="panel-title-area">
                        <ui:Label text="게임 몬스터" class="panel-title" />
                        <ui:Label text="제작 원본을 선택합니다." class="panel-caption" />
                    </ui:VisualElement>
                    <ui:Label name="catalog-count" text="0종" class="count-badge" />
                </ui:VisualElement>
                <ui:VisualElement class="catalog-search-row">
                    <ui:Label text="검색" class="catalog-search-label" />
                    <ui:TextField name="catalog-search" class="catalog-search" />
                </ui:VisualElement>
                <ui:VisualElement class="segmented-control">
                    <ui:Button name="sort-default" text="기본순" class="segmented-button segmented-button--active" />
                    <ui:Button name="sort-rarity" text="등급순" class="segmented-button" />
                </ui:VisualElement>
                <ui:VisualElement class="catalog-list-frame">
                    <ui:ListView name="catalog-list" class="catalog-list" />
                    <ui:Label name="catalog-empty" text="조건에 맞는 몬스터가 없습니다." class="empty-message" />
                </ui:VisualElement>
                <ui:Label name="catalog-status" text="운영 Catalog 확인 중..." class="catalog-status" />
                <ui:VisualElement class="catalog-actions">
                    <ui:Button name="reload-button" text="목록 새로고침" class="secondary-button" />
                    <ui:Button name="ping-button" text="Project 찾기" class="secondary-button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="editor-panel panel">
                <ui:VisualElement class="draft-header">
                    <ui:VisualElement class="draft-title-row">
                        <ui:Label text="Monster Maker V2" class="maker-title" />
                        <ui:Button name="catalog-toggle-button" text="목록 접기" class="catalog-toggle-button" />
                        <ui:Button name="help-toggle-button" text="도움말 끄기" tooltip="일반 설명만 숨깁니다. 오류와 경고는 계속 표시됩니다." class="help-toggle-button" />
                        <ui:Label name="dirty-badge" text="저장됨" class="state-badge state-badge--saved" />
                    </ui:VisualElement>
                    <ui:Label name="draft-status" text="제작 원본을 불러오는 중..." class="draft-status" />
                    <ui:VisualElement class="draft-header-actions">
                        <ui:Button name="open-draft-button" text="원본 열기" class="secondary-button" />
                        <ui:Button name="new-draft-button" text="새 몬스터" class="secondary-button" />
                        <ui:Button name="save-draft-button" text="원본 저장" class="primary-button" />
                        <ui:Button name="discard-button" text="변경 폐기" class="secondary-button discard-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="editor-column-header">
                    <ui:Label text="제작 데이터" class="column-heading" />
                    <ui:Label text="작업 사본 · 원본 저장 전까지 안전하게 편집" class="column-meta" />
                </ui:VisualElement>
                <ui:ScrollView name="draft-scroll" class="draft-scroll">
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="1. 기본 정보" class="section-title" />
                        <ui:VisualElement name="content-identity" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="2. 모델 설정" class="section-title" />
                        <ui:VisualElement name="content-model" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="3. 기본 능력치" class="section-title" />
                        <ui:VisualElement name="content-stats" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="4. 타격감 · 피격 반응" class="section-title" />
                        <ui:VisualElement name="content-impact" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="5. 메인 전투 역할 AI" class="section-title" />
                        <ui:VisualElement name="content-mainbattle" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="6. 스킬" class="section-title" />
                        <ui:VisualElement name="content-skills" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="7. 기본공격 제작" class="section-title" />
                        <ui:VisualElement name="content-combat" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="8. 대기 · 이동 · 사망 Motion" class="section-title" />
                        <ui:VisualElement name="content-motions" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="9. 군단의 역습 AI" class="section-title" />
                        <ui:VisualElement name="content-castle" class="section-content" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-section">
                        <ui:Label text="10. 돌파 옵션" class="section-title" />
                        <ui:VisualElement name="content-ascension" class="section-content" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement class="preview-panel panel">
                <ui:VisualElement class="panel-header preview-header">
                    <ui:VisualElement class="panel-title-area">
                        <ui:Label text="Live Preview" class="panel-title" />
                        <ui:Label name="preview-state" text="모델과 Motion을 확인합니다." class="panel-caption" />
                    </ui:VisualElement>
                    <ui:DropdownField name="environment-field" label="환경" class="environment-field" />
                </ui:VisualElement>

                <ui:VisualElement class="view-toolbar">
                    <ui:Label text="보기 설정" class="toolbar-label" />
                    <ui:Button name="view-front" text="정면" class="secondary-button" />
                    <ui:Button name="view-side" text="측면" class="secondary-button" />
                    <ui:Button name="view-diagonal" text="사선" class="secondary-button" />
                    <ui:Label text="우클릭 회전 · 휠 확대/축소" class="toolbar-hint" />
                </ui:VisualElement>

                <ui:VisualElement name="preview-render-host" class="preview-render-host">
                    <ui:VisualElement class="combat-status-card" picking-mode="Ignore">
                        <ui:Label name="combat-status" text="공격 버튼을 눌러 실제 타격을 확인하세요" class="combat-status" />
                        <ui:Label name="combat-detail" text="미리보기 준비 중" class="combat-detail" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="bottom-workspace">
                    <ui:VisualElement class="profile-card work-card">
                        <ui:VisualElement class="card-heading-row">
                            <ui:Label text="몬스터 프로필" class="card-title" />
                            <ui:Label text="현재 설정 요약" class="card-meta" />
                        </ui:VisualElement>
                        <ui:VisualElement class="profile-identity">
                            <ui:Image name="profile-portrait" class="profile-portrait" />
                            <ui:VisualElement class="profile-identity-text">
                                <ui:Label name="profile-name" text="이름 미지정" class="profile-name" />
                                <ui:Label name="profile-rarity" text="일반" class="profile-rarity rarity-common-bg" />
                                <ui:Label name="profile-id" text="ID 미입력" class="profile-value" />
                                <ui:Label name="profile-type" text="전투 설정 없음" class="profile-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="기본 능력치" class="profile-section-title" />
                        <ui:VisualElement class="profile-grid">
                            <ui:Label name="profile-health" text="체력 -" class="profile-value" />
                            <ui:Label name="profile-attack" text="공격 -" class="profile-value" />
                            <ui:Label name="profile-defense" text="방어 -" class="profile-value" />
                            <ui:Label name="profile-speed" text="공속 -" class="profile-value" />
                            <ui:Label name="profile-move" text="이속 -" class="profile-value" />
                            <ui:Label name="profile-range" text="사거리 -" class="profile-value" />
                        </ui:VisualElement>
                        <ui:Label text="전투 · 타격감" class="profile-section-title" />
                        <ui:Label name="profile-basic-attack" text="기본공격 · 미지정" class="profile-value profile-line" />
                        <ui:Label name="profile-impact" text="타격/피격 · -" class="profile-value profile-line" />
                        <ui:Label name="profile-skill" text="스킬 · 미사용" class="profile-value profile-line" />
                        <ui:Label text="AI" class="profile-section-title" />
                        <ui:Label name="profile-main-ai" text="메인 전투 · -" class="profile-value profile-line" />
                        <ui:Label name="profile-distance" text="전투 거리 · -" class="profile-value profile-line" />
                        <ui:Label name="profile-castle-ai" text="군단 역습 · -" class="profile-value profile-line" />
                    </ui:VisualElement>

                    <ui:VisualElement class="command-stack">
                        <ui:VisualElement class="timeline-card work-card">
                            <ui:VisualElement class="timeline-heading">
                                <ui:Label text="재생 위치" class="card-title" />
                                <ui:Label name="clip-label" text="모션 미선택" class="card-meta" />
                                <ui:Label name="timeline-value" text="0.000" class="timeline-value" />
                            </ui:VisualElement>
                            <ui:Slider name="timeline-slider" low-value="0" high-value="1" value="0" class="timeline-slider" />
                            <ui:Label text="0      타격/발사 Marker · 왼쪽 Motion에서 수동 지정      1" class="timeline-hint" />
                        </ui:VisualElement>

                        <ui:VisualElement class="edit-card work-card">
                            <ui:VisualElement class="card-heading-row">
                                <ui:Label text="작업 제어" class="card-title" />
                                <ui:Label text="미리보기 재생과 작업 기록" class="card-meta" />
                            </ui:VisualElement>
                            <ui:VisualElement class="preview-control-toolbar">
                                <ui:VisualElement class="control-row">
                                    <ui:Label text="재생" class="control-row-label" />
                                    <ui:VisualElement class="control-group">
                                        <ui:Button name="pause-button" text="Ⅱ 일시정지" class="secondary-button" />
                                        <ui:Button name="restart-button" text="↺ 처음부터" class="secondary-button" />
                                        <ui:Button name="show-area-button" text="◎ 판정 보기" class="secondary-button area-button" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="control-row control-row--history">
                                    <ui:Label text="기록" class="control-row-label" />
                                    <ui:VisualElement class="control-group">
                                        <ui:Button name="undo-button" text="↶ 실행 취소" class="secondary-button" />
                                        <ui:Button name="redo-button" text="↷ 다시 실행" class="secondary-button" />
                                        <ui:Button name="restore-button" text="↺ 초기 상태" class="secondary-button" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="motion-card work-card">
                            <ui:VisualElement class="card-heading-row">
                                <ui:Label text="모션 재생" class="card-title" />
                                <ui:Label text="상태 · 기본공격 · 액티브를 실제 타격과 함께 확인" class="card-meta" />
                            </ui:VisualElement>
                            <ui:VisualElement class="playback-toolbar">
                                <ui:Label text="상태" class="motion-row-label" />
                                <ui:Button name="play-idle" text="대기" class="motion-button motion-button--idle" />
                                <ui:Button name="play-move" text="이동" class="motion-button motion-button--move" />
                                <ui:Button name="play-death" text="사망" class="motion-button motion-button--danger" />
                            </ui:VisualElement>
                            <ui:VisualElement class="combat-playback-row">
                                <ui:Label text="전투" class="motion-row-label" />
                                <ui:VisualElement name="attack-buttons-host" class="attack-buttons-host">
                                    <ui:VisualElement name="attack-buttons" class="attack-buttons" />
                                </ui:VisualElement>
                                <ui:VisualElement class="active-motion-slot">
                                    <ui:Button name="play-active" text="액티브" class="motion-button motion-button--active active-motion-button" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="publish-toolbar">
                            <ui:Button name="validate-button" text="1. 입력 검증" class="validate-button" />
                            <ui:Button name="publish-button" text="2. 전투 반영" class="publish-button" />
                        </ui:VisualElement>

                        <ui:ScrollView name="command-details-scroll" class="command-details-scroll">
                            <ui:VisualElement name="validation-card" class="validation-card">
                                <ui:Label name="validation-summary" text="입력 검증 전" class="validation-summary" />
                                <ui:ScrollView name="validation-list" class="validation-list" />
                            </ui:VisualElement>

                            <ui:Foldout name="usage-guide" text="도움말 · 9단계 제작 흐름" value="false" class="usage-guide context-help">
                                <ui:Label text="1. 새 몬스터 또는 기존 제작 원본으로 시작하고 원본 저장으로 작업을 보관합니다." class="guide-step" />
                                <ui:Label text="2. ID·이름·등급·초상화와 모델 프리팹·애니메이터를 지정합니다." class="guide-step" />
                                <ui:Label text="3. 능력치, 타격 강도, 피격 체급과 메인 전투 역할을 정합니다." class="guide-step" />
                                <ui:Label text="4. 기본공격 프리셋을 선택하거나 조립소에서 새 공격을 만듭니다." class="guide-step" />
                                <ui:Label text="5. 공격 모션과 실제 타격/발사 시점을 맞춥니다." class="guide-step" />
                                <ui:Label text="6. 대기·이동·사망 모션과 필요한 고급 예외 연출을 지정합니다." class="guide-step" />
                                <ui:Label text="7. 미리보기 작업대에서 모션, 피해, 판정 범위를 확인합니다." class="guide-step" />
                                <ui:Label text="8. 입력 검증 오류를 왼쪽 제작 데이터에서 수정합니다." class="guide-step" />
                                <ui:Label text="9. 기존 식별자를 유지해 반영한 뒤 실제 전투에서 다시 확인합니다." class="guide-step" />
                                <ui:HelpBox text="카드 초상화와 3D 모델은 다른 자산입니다. 외부 원본은 수정하지 않으며 제작 미리보기 통과가 실제 전투 검증 완료를 뜻하지 않습니다." message-type="Warning" />
                            </ui:Foldout>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
