<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement class="sfx-adjust-root">
        <ui:VisualElement class="adjust-header panel-card">
            <ui:VisualElement class="adjust-title-area">
                <ui:Label name="adjust-title" text="SFX 보정" class="adjust-title" />
                <ui:Label text="지금 선택한 SFX 하나의 재생 구간과 피치만 조절합니다." class="adjust-caption" />
            </ui:VisualElement>
            <ui:Label text="V2" class="version-badge" />
        </ui:VisualElement>

        <ui:VisualElement class="panel-card clip-card">
            <ui:VisualElement class="heading-row">
                <ui:Label text="원본 AudioClip" class="section-title" />
                <ui:Button name="ping-button" text="Project에서 보기" class="mini-button" />
            </ui:VisualElement>
            <ui:Label name="clip-name" text="AudioClip" class="clip-name" />
            <ui:Label name="clip-info" text="원본 정보" class="caption" />
        </ui:VisualElement>

        <ui:VisualElement class="panel-card volume-card">
            <ui:VisualElement class="heading-row">
                <ui:Label text="음량 · 증폭" class="section-title" />
                <ui:Label name="volume-status" text="100%" class="status" />
            </ui:VisualElement>
            <ui:VisualElement class="volume-controls">
                <ui:Slider name="volume-slider" label="음량" low-value="0" high-value="2" value="1" class="volume-slider" />
                <uie:FloatField name="volume-field" label="정확한 값(%)" class="volume-field" />
            </ui:VisualElement>
            <ui:HelpBox name="volume-help" text="100%를 넘기면 약한 원본을 최대 200%까지 증폭합니다." message-type="Info" class="volume-help" />
        </ui:VisualElement>

        <ui:VisualElement class="panel-card range-card">
            <ui:VisualElement class="heading-row">
                <ui:Label text="재생 구간" class="section-title" />
                <ui:Label name="range-status" text="재생 구간" class="status" />
            </ui:VisualElement>
            <ui:MinMaxSlider name="range-slider" low-limit="0" high-limit="1" min-value="0" max-value="1" class="range-slider" />
            <ui:VisualElement class="range-caption-row">
                <ui:Label text="앞부분 건너뛰기" class="range-caption" />
                <ui:Label text="재생되는 부분" class="range-caption range-caption--center" />
                <ui:Label text="뒷부분 자르기" class="range-caption range-caption--right" />
            </ui:VisualElement>
            <ui:VisualElement class="paired-fields">
                <uie:FloatField name="start-offset-field" label="시작 오프셋(초)" class="half-field" />
                <uie:FloatField name="end-cut-field" label="끝 컷(초)" class="half-field half-field--last" />
            </ui:VisualElement>
            <ui:VisualElement class="preview-row">
                <ui:Button name="preview-button" text="▶ 설정 구간 미리듣기" class="primary-button preview-button" />
                <ui:Button name="stop-button" text="■ 정지" class="secondary-button stop-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="panel-card pitch-card">
            <ui:VisualElement class="heading-row">
                <ui:Toggle name="pitch-override" label="피치 직접 지정" class="pitch-toggle" />
                <ui:Label name="pitch-status" text="기존 랜덤 변주 유지" class="status" />
            </ui:VisualElement>
            <ui:VisualElement name="pitch-controls" class="pitch-controls">
                <ui:Slider name="pitch-slider" label="피치 배율" low-value="0.5" high-value="2" value="1" class="pitch-slider" />
                <uie:FloatField name="pitch-field" label="정확한 배율" class="pitch-field" />
            </ui:VisualElement>
            <ui:HelpBox name="pitch-help" text="기존 Cue 피치 변주를 유지합니다." message-type="Info" class="pitch-help" />
        </ui:VisualElement>

        <ui:VisualElement class="footer-row">
            <ui:Button name="defaults-button" text="원본 전체 · 기본 피치" class="secondary-button footer-button footer-button--wide" />
            <ui:Button name="reset-button" text="↻ 처음 값으로" class="secondary-button footer-button" />
            <ui:VisualElement class="footer-spacer" />
            <ui:Button name="cancel-button" text="취소" class="secondary-button footer-button" />
            <ui:Button name="apply-button" text="적용" class="primary-button footer-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
